#!/usr/bin/env bash
set -euo pipefail

# Block direct pushes to protected branches (develop, main)
# Git-flow requires feature branches → PR → develop
current_branch="$(git rev-parse --abbrev-ref HEAD)"

if [[ "$current_branch" == "develop" || "$current_branch" == "main" ]]; then
  echo "ERROR: Direct push to '$current_branch' is not allowed." >&2
  echo "" >&2
  echo "Git-flow workflow requires:" >&2
  echo "  1. Create a feature branch: git checkout -b feature/my-feature" >&2
  echo "  2. Push feature branch: git push -u origin feature/my-feature" >&2
  echo "  3. Open a PR to develop" >&2
  echo "" >&2
  echo "If you need to revert a bad commit already on $current_branch:" >&2
  echo "  git revert HEAD && git push" >&2
  exit 1
fi

# Block pushes when Kanbus artifact files are left uncommitted.
# These artifacts are used to share task state across systems/users.
status_output="$(git status --short)"
if command -v rg >/dev/null 2>&1; then
  pending="$(printf '%s\n' "${status_output}" | rg 'project/(issues|events)/' || true)"
else
  pending="$(printf '%s\n' "${status_output}" | grep -E 'project/(issues|events)/' || true)"
fi

if [[ -n "${pending}" ]]; then
  echo "ERROR: Uncommitted Kanbus artifacts detected:" >&2
  echo "${pending}" >&2
  echo "" >&2
  echo "Stage and commit project/issues and project/events changes before push." >&2
  echo "Hint: git add project/issues project/events && git commit -m 'Sync Kanbus artifacts'" >&2
  exit 1
fi
