#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:?commit message file path is required}"
subject_line="$(head -n 1 "$msg_file" | tr -d '\r')"

# Allow common auto-generated commit subjects.
if [[ "$subject_line" == Merge\ * ]]; then
  exit 0
fi
if [[ "$subject_line" == Revert\ \"* ]]; then
  exit 0
fi
if [[ "$subject_line" == fixup!\ * || "$subject_line" == squash!\ * ]]; then
  exit 0
fi

# Conventional Commits / semantic-release style:
# type(scope)!: subject
pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?(!)?: .+'

if [[ ! "$subject_line" =~ $pattern ]]; then
  echo "ERROR: Commit message must use semantic-release / Conventional Commits format." >&2
  echo "Expected: <type>(optional-scope)!: <description>" >&2
  echo "Examples:" >&2
  echo "  feat(api): add feedback search endpoint" >&2
  echo "  fix(tests): align feedback upsert expectations" >&2
  echo "  chore: update pre-push hook fallback" >&2
  echo "Allowed types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test" >&2
  echo "" >&2
  echo "Got: $subject_line" >&2
  exit 1
fi
